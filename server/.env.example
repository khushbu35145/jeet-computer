# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/jeet_web_solutions
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jeet_web_solutions?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jeet_web_solutions

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CLIENT_URL=http://localhost:5173

# Business & Contact Details (Defaults)
BRAND_NAME=JEET Computer Education
CONTACT_PHONE=7413919688
CONTACT_PHONE_ALT=8233316498
WHATSAPP_NUMBER=917413919688
CONTACT_EMAIL=info@jeeteducation.com
ADMIN_NOTIFICATION_EMAIL=info@jeeteducation.com
OFFICE_ADDRESS=Near Railway Station / Main Bus Stand, Pali, Rajasthan, 306401, India

# SMTP Email Configuration (Optional - platform functions gracefully if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JEET Web Solutions" <noreply@jeeteducation.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
